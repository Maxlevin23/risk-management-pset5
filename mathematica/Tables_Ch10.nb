Cell["\<\
This version, which takes in the portfolio NAV, reports Expected Vol in \
percentage terms unless NAV=1, in which case it does levels. There is an \
alternate version (for backwards compatability) that does not take in NAV, \
and that just calls this version with NAV=1.\
\>", "Text",
 CellChangeTimes->{{3.531437782482407*^9, 
  3.531437862241739*^9}},ExpressionUUID->"aade68ad-1409-405a-a096-\
66161c4f34ed"],

Cell[BoxData[
 RowBox[{
  RowBox[{"reportFunction1", "[", 
   RowBox[{"seclist_", ",", "holdings_", ",", "settledate_", ",", "nav_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "xx", ",", "portvol", ",", "yy", ",", "x", ",", "y", ",", "combvol", ",",
       "i", ",", "table", ",", "rflist", ",", "xx2", ",", "xx3", ",", "xx4", ",",
       "xx5", ",", "xx6", ",", "zz", ",", "volexplained", ",", "ordering", ",",
       "replicateport"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"portvol", " ", "=", " ", 
      RowBox[{"portVolbyVCVextended", "[", 
       RowBox[{"seclist", ",", "holdings", ",", "settledate"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", "\n", 
      RowBox[{
       RowBox[{
       "1.", " ", "portfolio", " ", "volatility", "\n", "2.", " ", "list", " ",
         "of", " ", "marginal", " ", "contributions", " ", 
        RowBox[{"(", "vector", ")"}], " ", "in", " ", "levels", " ", 
        RowBox[{"(", 
         RowBox[{"for", " ", "risk", " ", "factors"}], ")"}], "\n", "3.", " ",
         "marginal", " ", "contributions", " ", "proportional", "\n", "4.", " ",
         "All"}], "-", "or", "-", 
       RowBox[{"nothing", " ", "contribution", " ", 
        RowBox[{"(", 
         RowBox[{"change", " ", "in", " ", "vol", " ", "when", " ", "this", " ", 
          RowBox[{"pos", "'"}], "n", " ", "is", " ", "set", " ", "to", " ", 
          "zero"}], ")"}], "\n", "5.", " ", "Best", " ", "hedge", " ", 
        "position", " ", 
        RowBox[{"(", 
         RowBox[{"in", " ", "same", " ", "units", " ", "as", " ", 
          StyleBox[
           RowBox[{"input", 
            StyleBox["holdings",
             FontSlant->"Italic"]}]]}], ")"}]}], "-", 
       RowBox[{
       "must", " ", "fix", " ", "because", " ", "by", " ", "RFs", " ", "not", 
        " ", "securities", "\n", "6.", " ", "Volatility", " ", "at", " ", 
        "best", " ", "hedge", "\n", "7.", " ", "Stand"}], "-", 
       RowBox[{
       "alone", " ", "volatilities", " ", "of", " ", "individual", " ", 
        "risk", " ", "factors", "\n", "8.", " ", "RF", " ", "list", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"remember", " ", "that", " ", "although", " ", 
           StyleBox["seclist",
            FontSlant->"Italic"], 
           StyleBox[" ",
            FontSlant->"Italic"], "is", " ", "input"}], ",", 
          RowBox[{
          "risk", " ", "is", " ", "done", " ", "by", " ", "RFs", "\n", "9.", " ",
            "DV01s", " ", "by", " ", "RFs", " ", "per", " ", "1", " ", "unit",
            " ", "holdings", "\n", "10.", " ", "Correlations", " ", "of", " ",
            "RFs", " ", "with", " ", "portfolio", "\n", "11.", " ", 
           "Replicating", " ", "position", " ", 
           RowBox[{"(", 
            RowBox[{"=", 
             RowBox[{"original", "-", 
              RowBox[{"best", " ", "hedge"}]}]}], ")"}], " ", "\[IndentingNewLine]",
            "12.", " ", "DV01s", " ", "by", " ", "RFs", " ", 
           RowBox[{"(", 
            RowBox[{"actual", " ", "holdings"}], ")"}], "\n", "13.", " ", 
           "VCV", " ", "matrix"}]}], "   "}]}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"combvol", "=", 
      RowBox[{"portvol", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rflist", " ", "=", " ", 
      RowBox[{"portvol", "[", 
