Cell["To display the securities and RFs, DV01s, and Vols", "Text",
 CellChangeTimes->{{3.539302213772176*^9, 3.539302228097474*^9}, {
  3.539302268319324*^9, 
  3.539302269839568*^9}},ExpressionUUID->"0cab9ddd-dac3-4fec-844b-\
fa078f879573"],

Cell[BoxData[
 RowBox[{
  RowBox[{"displayRF", "[", 
   RowBox[{"seclist_", ",", "holdings_", ",", "settledate_"}], "]"}], " ", ":=",
   " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "x", ",", "xx", ",", "y", ",", "z", ",", "secDV01s", ",", "outTable", ",",
       "i", ",", "j", ",", "symb", ",", "isocode", ",", "vcv", ",", "secVols",
       ",", "rfVols"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"symb", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<$\>\"", ",", "\"\<\[Yen]\>\"", ",", "\"\<\[Sterling]\>\"",
         ",", "\"\<\[Euro]\>\""}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"isocode", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<USD\>\"", ",", "\"\<JPY\>\"", ",", "\"\<GBP\>\"", 
        ",", "\"\<EUR\>\""}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"secDV01s", " ", "=", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"populateSecDV01s", "[", 
        RowBox[{"seclist", ",", "holdings", ",", "settledate"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"secVols", " ", "=", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"secVolbyVCV", "[", 
        RowBox[{"seclist", ",", "holdings", ",", "settledate"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rfVols", " ", "=", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"rfVolbyVCV", "[", 
        RowBox[{"seclist", ",", "holdings", ",", "settledate"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"outTable", "=", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"\"\<Security\>\"", ",", "\"\<Notional\>\"", 
         ",", "\"\<Security Vol\>\"", ",", "\"\<RIsk Factor\>\"", 
         ",", "\"\<DV01\>\"", ",", "\"\<DV01 units\>\"", 
         ",", "\"\<RF unit Vol\>\"", ",", "\"\<RF pos'n Vol\>\""}], "}"}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "seclist", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "   ", 
       RowBox[{"(*", " ", 
        RowBox[{"Loop", " ", "through", " ", "securities"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"fxsymb", "[", 
          RowBox[{
           RowBox[{"seclist", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "symb", ",", "isocode"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"x", " ", "=", " ", 
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"holdings", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "<>", "\"\<mn\>\""}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"y", " ", "=", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"secVols", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "0"}], "}"}], ",", 
           RowBox[{"DigitBlock", "\[Rule]", "3"}], ",", 
           RowBox[{"NumberPoint", "\[Rule]", "\"\<\>\""}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"seclist", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", "Bold"}], "]"}], ",", "x",
             ",", "y", ",", "\"\<\>\"", ",", "\"\<\>\"", ",", "\"\<\>\"", 
            ",", "\"\<\>\"", ",", "\"\<\>\""}], "}"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"outTable", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"outTable", ",", "x"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", " ", "[", 
         RowBox[{
          RowBox[{"j", "=", "1"}], ",", 
          RowBox[{"j", "<=", 
           RowBox[{"Length", "[", 
            RowBox[{"secDV01s", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}]}], ",", 
          RowBox[{"j", "++"}], ",", "   ", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Loop", " ", "through", " ", "RFs", " ", "for", " ", "each", " ", 
            "security", " ", "and", " ", "figure", " ", "out", " ", "RF", " ",
             "items"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"x", " ", "=", " ", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"\"\<\>\"", ",", "\"\<\>\"", ",", "\"\<\>\"", ",", 
               RowBox[{"secDV01s", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "2", ",", "j"}], "]"}], "]"}], ",", 
               RowBox[{"NumberForm", "[", 
                RowBox[{
                 RowBox[{"secDV01s", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "3", ",", "j"}], "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"5", ",", "0"}], "}"}], ",", 
                 RowBox[{"DigitBlock", "\[Rule]", "3"}], ",", 
                 RowBox[{"NumberPoint", "\[Rule]", "\"\<\>\""}]}], "]"}], 
               ",", "\"\<\>\"", ",", "\"\<\>\"", ",", "\"\<\>\""}], "}"}], 
             "}"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"y", "=", 
            RowBox[{
             RowBox[{"Pick", "[", 
              RowBox[{"riskFactorBumpTypes", ",", "riskFactorNames", ",", 
               RowBox[{"x", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "4"}], "]"}], "]"}]}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ";", "  ", 
           RowBox[{"(*", " ", 
            RowBox[{"Figure", " ", "out", " ", "bump", " ", "type"}], " ", 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"x", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "6"}], "]"}], "]"}], "=", "y"}], ";", 
           "      ", 
           RowBox[{"(*", " ", 
            RowBox[{"put", " ", "into", " ", "line"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"z", "=", 
            RowBox[{
             RowBox[{"Pick", "[", 
              RowBox[{"marketVols", ",", "marketDataNames", ",", 
               RowBox[{"x", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "4"}], "]"}], "]"}]}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ";", "  ", 
           RowBox[{"(*", " ", 
            RowBox[{"Figure", " ", "out", " ", "vol"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"xx", " ", "=", 
            RowBox[{"NumberForm", "[", 
             RowBox[{"z", ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"y", "==", "\"\<percent\>\""}], ",", 
                RowBox[{"{", 
                 RowBox[{"5", ",", "5"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"4", ",", "3"}], "}"}]}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"x", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "7"}], "]"}], "]"}], " ", "=", " ", "xx"}], ";",
            "     ", 
           RowBox[{"(*", " ", 
            RowBox[{"insert", " ", "vol", " ", "in"}], " ", "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"y", " ", "=", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"secDV01s", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "3", ",", "j"}], "]"}], "]"}], "*", "z"}],
                "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"4", ",", "0"}], "}"}], ",", 
              RowBox[{"DigitBlock", "\[Rule]", "3"}], ",", 
              RowBox[{"NumberPoint", "\[Rule]", "\"\<\>\""}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"x", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "8"}], "]"}], "]"}], "=", "y"}], ";", 
           "          ", 
           RowBox[{"(*", " ", 
            RowBox[{
            "insert", " ", "rf", " ", "vol", " ", "for", " ", "this", " ", 
             "position"}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"outTable", " ", "=", " ", 
            RowBox[{"Join", "[", 
             RowBox[{"outTable", ",", "x"}], "]"}]}], ";"}]}], "      ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "tack", " ", "on", " ", "line", " ", "of", " ", "RF", " ", "data"}],
           " ", "*)"}], "\[IndentingNewLine]", "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Grid", "[", 
      RowBox[{"outTable", ",", 
       RowBox[{"Frame", "\[Rule]", "All"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
