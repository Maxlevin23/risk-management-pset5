Cell[BoxData[
 RowBox[{
  RowBox[{"reportFunction1", "[", 
   RowBox[{"seclist_", ",", " ", "holdings_", ",", " ", "settledate_"}], 
   "]"}], " ", ":=", 
  RowBox[{"reportFunction1", "[", 
   RowBox[{"seclist", ",", "holdings", ",", "settledate", ",", "1"}], "]"}], 
  " "}]], "Input",
 CellChangeTimes->{{3.531438087570011*^9, 3.531438142974799*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"dad040a8-5c69-4eb3-b2c4-9933c926db95"],

Cell[BoxData[
 RowBox[{
  RowBox[{"volbySubPortfolio", "[", 
   RowBox[{
   "seclist_", ",", "holdings_", ",", "settledate_", ",", "subportfolio_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "x1", ",", "x2", ",", "x3", ",", "x4", ",", "subportlist", ",", 
      "noclass", ",", "results", ",", "i", ",", "j", ",", "xhold", ",", 
      "table", ",", "partial", ",", "zeros"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"subportlist", "=", 
      RowBox[{"Union", "[", "subportfolio", "]"}]}], ";", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "List", " ", "of", " ", "unique", " ", "asset", " ", "classes"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"noclass", "=", 
      RowBox[{"Length", "[", "subportlist", "]"}]}], ";", "          ", 
     RowBox[{"(*", " ", 
      RowBox[{"Number", " ", "of", " ", "asset", " ", "classes"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"zeros", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"Length", "[", "holdings", "]"}]}], "]"}]}], ";", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "used", " ", "for", " ", "holding", " ", "subportfolio", " ", 
       "holdings"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"results", " ", "=", "  ", 
      RowBox[{"portVolbyVCVextended", "[", 
       RowBox[{"seclist", ",", "holdings", ",", "settledate"}], "]"}]}], ";", 
     "  ", 
     RowBox[{"(*", " ", 
      RowBox[{"for", " ", "complete", " ", "portfolio"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "\[LessEqual]", "noclass"}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"x1", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Position", "[", 
           RowBox[{"subportfolio", ",", 
            RowBox[{"subportlist", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}]}], ";", "   ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "indexes", " ", "of", " ", "this", " ", "asset", " ", "class", " ", 
          "in", " ", "seclist"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"xhold", " ", "=", " ", "zeros"}], ";", 
        RowBox[{
         RowBox[{"xhold", "[", 
          RowBox[{"[", "x1", "]"}], "]"}], "=", 
         RowBox[{"holdings", "[", 
          RowBox[{"[", "x1", "]"}], "]"}]}], ";", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "insert", " ", "holdings", " ", "for", " ", "this", " ", 
          "subportfolio"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"x2", " ", "=", " ", 
         RowBox[{"portVolbyVCVextended", "[", 
          RowBox[{"seclist", ",", "xhold", ",", "settledate"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"results", " ", "=", " ", 
         RowBox[{"Join", "[", 
          RowBox[{"results", ",", "x2"}], "]"}]}], ";"}]}], "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
         "This", " ", "stacks", " ", "additional", " ", "results", " ", 
          "onto", " ", "the", " ", "end"}], " ", "-", " ", 
         RowBox[{
         "each", " ", "\"\<results\>\"", " ", "is", " ", "13", " ", 
          "long"}]}], ",", " ", 
        RowBox[{"so", " ", "two", " ", "stacked", " ", "is", " ", "26"}], ",",
         " ", 
        RowBox[{"3", " ", "is", " ", "39"}], ",", " ", "..."}], " ", "*)"}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"partial", " ", "=", " ", 
      RowBox[{
       RowBox[{"results", "[", 
        RowBox[{"[", "13", "]"}], "]"}], ".", 
       RowBox[{"results", "[", 
        RowBox[{"[", "12", "]"}], "]"}]}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"Matrix", " ", "multiplication", " ", "of", " ", 
       RowBox[{"VCV", " ", ".", " ", "Delta"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"table", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<\>\"", ",", "\"\<Exp Vol ($)\>\"", 
          ",", "\"\<Contribution\>\"", ",", "\"\<Correlation\>\""}], "}"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"\"\<Overall\>\"", ",", 
          RowBox[{"AccountingForm", "[", 
           RowBox[{
            RowBox[{"x1", "=", 
             RowBox[{"results", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "0"}], "}"}], ",", 
            RowBox[{"DigitBlock", "\[Rule]", "3"}], ",", 
            RowBox[{"NumberPoint", "\[Rule]", "\"\<\>\""}]}], "]"}], 
          ",", "\"\<100.0\>\"", ",", "\"\<with portfolio\>\""}], "}"}]}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"table", " ", "=", " ", 
      RowBox[{"Join", "[", 
       RowBox[{"table", ",", "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"subportlist", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"AccountingForm", "[", 
             RowBox[{
              RowBox[{"x2", "=", 
               RowBox[{"results", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"13", "*", "i"}], "+", "1"}], "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"4", ",", "0"}], "}"}], ",", 
              RowBox[{"DigitBlock", "\[Rule]", "3"}], ",", 
              RowBox[{"NumberPoint", "\[Rule]", "\"\<\>\""}]}], "]"}], ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"x3", "=", 
               RowBox[{"100", "*", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"results", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"13", "*", "i"}], "+", "12"}], "]"}], "]"}], ".", 
                   "partial"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"x1", "^", "2"}], ")"}]}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"4", ",", "1"}], "}"}]}], "]"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"x2", ">", "0"}], ",", 
              RowBox[{"NumberForm", "[", 
               RowBox[{
                RowBox[{"x3", "*", 
                 RowBox[{"x1", "/", 
                  RowBox[{"(", 
                   RowBox[{"100", "*", "x2"}], ")"}]}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"4", ",", "3"}], "}"}]}], "]"}], ",", "\"\<\>\""}], 
             "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "noclass"}], "}"}]}], "]"}]}], 
       "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.525625435359375*^9, 3.525625469609375*^9}, {
  3.525625672265625*^9, 3.525625694140625*^9}, {3.525625805359375*^9, 
  3.525626020515625*^9}, {3.525626321421875*^9, 3.52562642625*^9}, {
  3.525626461515625*^9, 3.525626546140625*^9}, {3.52562657796875*^9, 
  3.52562667953125*^9}, {3.5256267589375*^9, 3.52562698384375*^9}, {
  3.525627455734375*^9, 3.52562770403125*^9}, {3.525627995015625*^9, 
  3.525628020640625*^9}, {3.525628293734375*^9, 3.525628302375*^9}, {
  3.525628481234375*^9, 3.52562858340625*^9}, {3.52562891434375*^9, 
  3.52562892028125*^9}, {3.525629252640625*^9, 3.525629253109375*^9}, {
  3.5256304011875*^9, 3.525630423375*^9}, {3.52563046009375*^9, 
  3.5256305688125*^9}, {3.89240873481839*^9, 3.892408756208436*^9}, {
  3.892408790140168*^9, 3.8924087981942997`*^9}, {3.892408842261541*^9, 
  3.8924088477325087`*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"9b98e5d1-1080-4177-b0d7-8e413c7c1de9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"varsumm", "[", 
   RowBox[{"seclist_", ",", "holdings_", ",", "settledate_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "x1", ",", "x2", ",", "alpha", ",", "beta", ",", "mixfact", ",", 
      "normalmix"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x1", "=", 
      RowBox[{"portVolbyVCV", "[", 
       RowBox[{"seclist", ",", "holdings", ",", "settledate"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"alpha", "=", "0.01"}], ";", 
     RowBox[{"beta", "=", "5"}], ";", 
     RowBox[{"mixfact", " ", "=", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", "alpha", " ", "+", " ", 
        RowBox[{"alpha", "*", "beta", "*", "beta"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"normalmix", "[", "vol_", "]"}], ":=", 
      RowBox[{"MixtureDistribution", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "-", "alpha"}], ",", "alpha"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"0", ",", 
            RowBox[{"vol", "/", "mixfact"}]}], "]"}], ",", 
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"0", ",", 
            RowBox[{"beta", "*", 
             RowBox[{"vol", "/", "mixfact"}]}]}], "]"}]}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"x2", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<VOLATILITY and 1-ot-of 255 VaR\>\"", ",", 
          "SpanFromLeft"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"\"\<Volatility\>\"", ",", 
          RowBox[{"AccountingForm", "[", 
           RowBox[{"x1", ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "0"}], "}"}], ",", 
            RowBox[{"DigitBlock", "\[Rule]", "3"}], ",", 
            RowBox[{"NumberPoint", "\[Rule]", "\"\<\>\""}]}], "]"}]}], "}"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"\"\<VaR Normal\>\"", ",", 
          RowBox[{"AccountingForm", "[", 
           RowBox[{
            RowBox[{"Quantile", "[", 
             RowBox[{
              RowBox[{"NormalDistribution", "[", 
               RowBox[{"0", ",", "x1"}], "]"}], ",", 
              RowBox[{"1", "/", "255"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "0"}], "}"}], ",", 
            RowBox[{"DigitBlock", "\[Rule]", "3"}], ",", 
            RowBox[{"NumberPoint", "\[Rule]", "\"\<\>\""}]}], "]"}]}], "}"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"\"\<VaR Student-t (6df)\>\"", ",", 
          RowBox[{"AccountingForm", "[", 
           RowBox[{
            RowBox[{"x1", "*", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"4", "/", "6"}], "]"}], "*", 
             RowBox[{"Quantile", "[", 
              RowBox[{
               RowBox[{"StudentTDistribution", "[", "6", "]"}], ",", 
               RowBox[{"1", "/", "255"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "0"}], "}"}], ",", 
            RowBox[{"DigitBlock", "\[Rule]", "3"}], ",", 
            RowBox[{"NumberPoint", "\[Rule]", "\"\<\>\""}]}], "]"}]}], "}"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"\"\<VaR Normal Mix (\[Alpha]=1% \[Beta]=5)\>\"", ",", 
          RowBox[{"AccountingForm", "[", 
           RowBox[{
            RowBox[{"Quantile", "[", 
             RowBox[{
              RowBox[{"normalmix", "[", "x1", "]"}], ",", 
              RowBox[{"1", "/", "255"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "0"}], "}"}], ",", 
            RowBox[{"DigitBlock", "\[Rule]", "3"}], ",", 
            RowBox[{"NumberPoint", "\[Rule]", "\"\<\>\""}]}], "]"}]}], "}"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"\"\<VaR 4-sigma rule-of-thumb\>\"", ",", 
          RowBox[{"AccountingForm", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "4"}], "*", "x1"}], ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "0"}], "}"}], ",", 
            RowBox[{"DigitBlock", "\[Rule]", "3"}], ",", 
            RowBox[{"NumberPoint", "\[Rule]", "\"\<\>\""}]}], "]"}]}], 
         "}"}]}], "}"}]}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.52573115153125*^9, 3.525731152703125*^9}, {
  3.525731185546875*^9, 3.525731457125*^9}, {3.5257315360625*^9, 
  3.52573164025*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"ed8a4d59-dc5d-4486-9724-d39ba70c4864"],

Cell["\<\
For the detailed table - matrix of currencies across, yields (and FX) down\
\>", "Text",
 CellChangeTimes->{{3.52582896496875*^9, 
  3.525828985703125*^9}},ExpressionUUID->"868a3ed0-88f4-4d25-9cab-\
5f8c2b05e184"],

Cell[BoxData[
 RowBox[{
  RowBox[{"detailtable", "[", 
   RowBox[{"seclist_", ",", "holdings_", ",", "settledate_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "table", ",", "table2", ",", "portvol", ",", "datamc", ",", "datavol", ",",
       "i", ",", "j", ",", "k", ",", "currlist", ",", "matlist"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"portvol", "=", 
      RowBox[{"portVolbyVCVextended", "[", 
       RowBox[{"seclist", ",", "holdings", ",", "settledate"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"datamc", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"\"\<\>\"", ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "3"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"datavol", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"\"\<\>\"", ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "3"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"currlist", "=", 
      RowBox[{"{", 
       RowBox[{"\"\<USD\>\"", ",", "\"\<GBP\>\"", ",", "\"\<EUR\>\""}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"matlist", "=", 
      RowBox[{"{", 
       RowBox[{"\"\<Yld2yr\>\"", ",", "\"\<Yld5yr\>\"", ",", "\"\<Yld10yr\>\"",
         ",", "\"\<Yld30yr\>\"", ",", "\"\<FX\>\""}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "\[LessEqual]", "5"}], ",", 
       RowBox[{"i", "++"}], ",", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Go", " ", "over", " ", "rates", " ", 
         RowBox[{"(", "rows", ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"j", "=", "1"}], ",", 
          RowBox[{"j", "\[LessEqual]", "3"}], ",", 
          RowBox[{"j", "++"}], " ", ",", "   ", 
          RowBox[{"(*", " ", 
           RowBox[{"Over", " ", "currencies"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"k", "=", 
                RowBox[{"Position", "[", 
                 RowBox[{
                  RowBox[{"portvol", "[", 
                   RowBox[{"[", "8", "]"}], "]"}], ",", 
                  RowBox[{
                   RowBox[{"currlist", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "<>", 
                   RowBox[{"matlist", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], "]"}], "\[Equal]",
               "1"}], ",", "  ", 
             RowBox[{"(*", " ", 
              RowBox[{"this", " ", "RF", " ", "has", " ", "data"}], " ", 
              "*)"}], "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"k", " ", "=", " ", 
               RowBox[{"k", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"datamc", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
               RowBox[{"100", "*", 
                RowBox[{"portvol", "[", 
                 RowBox[{"[", 
                  RowBox[{"3", ",", "k"}], "]"}], "]"}]}]}], ";", "    ", 
              RowBox[{"(*", " ", "MC", " ", "*)"}], "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"datavol", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
               RowBox[{
                RowBox[{"Sign", "[", 
                 RowBox[{"portvol", "[", 
                  RowBox[{"[", 
                   RowBox[{"12", ",", "k"}], "]"}], "]"}], "]"}], "*", 
                RowBox[{"portvol", "[", 
                 RowBox[{"[", 
                  RowBox[{"7", ",", "k"}], "]"}], "]"}]}]}], ";"}], ",", "  ", 
             RowBox[{"(*", " ", 
              RowBox[{"stand", "-", 
               RowBox[{"alone", " ", "vols"}]}], " ", "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{"Null", ";"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", 
         "]"}], ";"}]}], "      ", 
      RowBox[{"(*", " ", 
       RowBox[{"end", " ", "j"}], " ", "*)"}], "\[IndentingNewLine]", "]"}], ";",
      "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"end", " ", "i"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"table", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Yield Curve\>\"", ",", "\"\<USD\>\"", 
           ",", "\"\<GBP\>\"", ",", "\"\<EUR\>\""}], "}"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"matlist", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "}"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"NumberForm", "[", 
               RowBox[{
                RowBox[{"datamc", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "j"}], "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"3", ",", "1"}], "}"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "5"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"table2", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Yield Curve\>\"", ",", "\"\<USD\>\"", 
           ",", "\"\<GBP\>\"", ",", "\"\<EUR\>\""}], "}"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"matlist", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "}"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"NumberForm", "[", 
               RowBox[{
                RowBox[{"datavol", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "j"}], "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"4", ",", "0"}], "}"}], ",", 
                RowBox[{"DigitBlock", "\[Rule]", "3"}], ",", 
                RowBox[{"NumberPoint", "\[Rule]", "\"\<\>\""}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "5"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{"table", ",", "table2"}], "}"}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
