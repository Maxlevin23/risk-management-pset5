  3.9985106377984657`*^9}},ExpressionUUID->"7dd1b9d6-5501-4865-afaa-\
160a71748980"],

Cell[TextData[{
 "This section shows a static version of the sample portfolio from section \
10.6 of ",
 StyleBox["Quantitative Risk Management",
  FontSlant->"Italic"],
 ", together with the risk reports. The intention is to provide a fixed, \
static version which users can refer to. "
}], "Text",
 CellChangeTimes->{{3.539394338991705*^9, 3.539394400614686*^9}, {
  3.892408641027143*^9, 
  3.8924086436259193`*^9}},ExpressionUUID->"a57a1073-3200-4d03-8d9f-\
44902cb32516"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"n", "=", "9"}], ",", 
     RowBox[{"max", "=", 
      RowBox[{"Max", "[", "holdings", "]"}]}], ",", 
     RowBox[{"min", "=", 
      RowBox[{"Min", "[", "holdings", "]"}]}], ",", "xx", ",", "yy", ",", 
     RowBox[{"currlist", "=", "seclist"}], ",", "i", ",", "x2", ",", "y2"}], 
    "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xx", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<$\>\"", ",", "\"\<\[Yen]\>\"", ",", "\"\<\[Sterling]\>\"", 
       ",", "\"\<\[Euro]\>\""}], "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"yy", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<USD\>\"", ",", "\"\<JPY\>\"", ",", "\"\<GBP\>\"", 
       ",", "\"\<EUR\>\""}], "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "<", 
       RowBox[{"Length", "[", "seclist", "]"}]}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x2", " ", "=", " ", 
        RowBox[{"fxrateSec", "[", 
         RowBox[{"seclist", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ";", 
       RowBox[{
        RowBox[{"currlist", "[", 
         RowBox[{"[", "i", "]"}], "]"}], " ", "=", " ", 
        RowBox[{
         RowBox[{"Pick", "[", 
          RowBox[{"xx", ",", "yy", ",", 
           RowBox[{"x2", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Grid", "[", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"\"\<Security\>\"", ",", "\"\<Amount (mn local)\>\"", 
          ",", "\"\<Curr\>\"", ",", "\"\<Subportfolio\>\""}], "}"}], "}"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"PopupMenu", "[", 
            RowBox[{
             RowBox[{"seclist", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "seclist"}], "]"}], ",", 
           RowBox[{"Slider", "[", 
            RowBox[{
             RowBox[{"holdings", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"Appearance", "\[Rule]", "\"\<Labeled\>\""}], ",", 
             RowBox[{"{", 
              RowBox[{"min", ",", "max"}], "}"}]}], "]"}], ",", 
           RowBox[{"currlist", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"PopupMenu", "[", 
            RowBox[{
             RowBox[{"subportfolio", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "subportfolio"}], "]"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], "]"}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.5392098490801477`*^9, 3.539209868118471*^9}, {
  3.539209908062251*^9, 3.5392099229248857`*^9}, {3.539209953394022*^9, 
