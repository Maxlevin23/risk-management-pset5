Cell["\<\
Table that produces Pos\[CloseCurlyQuote]n Vol, MC Levels, All-or-nothing \
Cont\[CloseCurlyQuote]n, Best Hedges Pos\[CloseCurlyQuote]n, Vol at Best \
Hedges, for arbitrary no. of instruments. Problem when there is not a 1-to-1 \
correspondence between securities and RFs - in such a case the function does \
not put amounts in the labels.\
\>", "Text",
 CellChangeTimes->{{3.519483496669967*^9, 3.519483539506303*^9}, {
  3.519493790003275*^9, 
  3.519493841529192*^9}},ExpressionUUID->"1f30b54f-e88f-4aee-9cac-\
a5d6f0978d27"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tableContributers", "[", 
    RowBox[{
    "ordering_", ",", "rflist_", ",", "portvol_", ",", "volexplained_", ",", 
     "combvol_", ",", "nav_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xx2", ",", "xx3", ",", "k"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"k", " ", "=", " ", 
       RowBox[{"Length", "[", "ordering", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xx2", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          
          RowBox[{"\"\<\>\"", ",", " ", "\"\<Exp Vol\>\"", ",", 
           " ", "\"\<\>\"", ",", " ", "\"\<Curr Pos'n\>\"", ",", 
           " ", "\"\<Trade to best\>\"", ",", 
           " ", "\"\<% Reduction in Vol to\>\"", ",", " ", "SpanFromLeft"}], 
          "}"}], ",", "\n", "   ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<\>\"", ",", " ", "\"\<(1-sig P&L)\>\"", ",", 
           " ", "\"\<Contribution\>\"", ",", " ", "\"\<(mn eqv)\>\"", ",", 
           " ", "\"\<Hedge (eqv)\>\"", ",", " ", "\"\<Best Hedge\>\"", ",", 
           " ", "\"\<Zero Pos'n\>\""}], "}"}]}], "}"}]}], ";", "\n", 
      RowBox[{"xx3", " ", "=", " ", 
       RowBox[{"Join", "[", 
        RowBox[{"xx2", ",", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"rflist", "[", 
              RowBox[{"[", 
               RowBox[{"ordering", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", "\n", 
             "     ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"nav", ">", "1"}], ",", "\[IndentingNewLine]", 
               RowBox[{"NumberForm", "[", 
                RowBox[{
                 RowBox[{"100", "*", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"portvol", "[", 
                    RowBox[{"[", "7", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"ordering", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "/", 
                   "nav"}]}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"5", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
               RowBox[{"(*", " ", 
                RowBox[{"RF", " ", "vol", " ", "in", " ", "percentage"}], " ",
                 "*)"}], "\[IndentingNewLine]", 
               RowBox[{"AccountingForm", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"portvol", "[", 
                   RowBox[{"[", "7", "]"}], "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"ordering", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"4", ",", " ", "0"}], "}"}], ",", " ", 
                 RowBox[{"DigitBlock", " ", "->", " ", "3"}], ",", " ", 
                 RowBox[{"NumberPoint", " ", "->", " ", "\"\<\>\""}]}], 
                "]"}]}], "]"}], ",", " ", 
             RowBox[{"(*", " ", 
              RowBox[{"RF", " ", "vol"}], " ", "*)"}], "\n", "     ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"100", "*", 
                RowBox[{
                 RowBox[{"portvol", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"ordering", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "1"}], "}"}]}], "]"}], ",", " ", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{"Cont", "'"}], "n"}], " ", "*)"}], "\n", "     ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"portvol", "[", 
                   RowBox[{"[", "5", "]"}], "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"ordering", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], " ", "+", 
                 " ", 
                 RowBox[{
                  RowBox[{"portvol", "[", 
                   RowBox[{"[", "11", "]"}], "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"ordering", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], ")"}], ",",
                " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "1"}], "}"}]}], "]"}], ",", " ", 
             RowBox[{"(*", " ", 
              RowBox[{"Original", " ", 
               RowBox[{"pos", "'"}], "n"}], " ", "*)"}], "\n", "     ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{
                 RowBox[{"portvol", "[", 
                  RowBox[{"[", "11", "]"}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"ordering", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "1"}], "}"}]}], "]"}], ",", " ", 
             RowBox[{"(*", " ", 
              RowBox[{"Trade", " ", "to", " ", "best", " ", "hedge"}], " ", 
              "*)"}], "\n", "     ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"volexplained", "[", 
                RowBox[{"[", 
                 RowBox[{"ordering", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "1"}], "}"}]}], "]"}], ",", " ", 
             RowBox[{"(*", " ", 
              RowBox[{"Vol", " ", "explained", " ", "%"}], " ", "*)"}], "\n", 
             "     ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"100", "*", 
                RowBox[{
                 RowBox[{
                  RowBox[{"portvol", "[", 
                   RowBox[{"[", "4", "]"}], "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"ordering", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "/", 
                 "combvol"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "1"}], "}"}]}], "]"}]}], 
            RowBox[{"(*", " ", 
             RowBox[{"Vol", " ", "explained", " ", "%"}], " ", "*)"}], "}"}], 
           ",", "\n", "    ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "1", ",", " ", "k"}], "}"}]}], "]"}]}], 
        "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], "\n"}]], "Input",
 CellChangeTimes->{{3.525470633078125*^9, 3.52547074525*^9}, {
   3.52547087940625*^9, 3.525470889546875*^9}, {3.52547095665625*^9, 
   3.525470981515625*^9}, {3.525471271890625*^9, 3.525471327140625*^9}, 
   3.525473059078125*^9, {3.525537021265625*^9, 3.5255370258125*^9}, {
   3.531578756859375*^9, 3.53157887053125*^9}, {3.531578930453125*^9, 
   3.5315789313125*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"fa592d7f-0826-412f-9dc3-87e6469f668f"],

