Cell[CellGroupData[{

Cell["\<\
Function for best replicating portfolio (by simple step-wise)\
\>", "Subsubsubsection",
 CellChangeTimes->{{3.525556430640625*^9, 
  3.5255564576875*^9}},ExpressionUUID->"a0313e52-328e-446b-8016-8224ca6638c3"],

Cell["\<\
This builds up a series of replicating portfolios (from 1 to 5 securities) by \
choosing the best single, then selecting a second that, when taken with the \
first, produces maximum reduction in variance, etc.\
\>", "Text",
 CellChangeTimes->{{3.525556461453125*^9, 
  3.5255565126875*^9}},ExpressionUUID->"d630dc21-7ec6-4e6f-b0a1-21f4b6d6f044"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bestReplicatePort", "[", 
   RowBox[{"delta_", ",", "sigma_", ",", "rfnames_", ",", "rfunitDV01s_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "x", ",", "y", ",", "z", ",", "part", ",", "portvar", ",", "dstar", ",", 
      "index", ",", "portvar5", ",", "varchk", ",", "i", ",", "j", ",", "k", ",",
       "portsize", ",", "partint", ",", "sigmaint", ",", "dstarint", ",", 
      "varint", ",", "dstarint5", ",", "nosec", ",", "portvarPercent", ",", 
      "names", ",", "amounts", ",", "portvolPercent"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"The", " ", "'"}], 
      RowBox[{"inputs", "'"}], " ", "are"}], 
     "                                           ", "*)"}], "\n", 
    RowBox[{"(*", "    ", 
     RowBox[{"delta", " ", "-", " ", 
      RowBox[{
      "column", " ", "vector", " ", "of", " ", "deltas", " ", "or", " ", 
       "portfolio", " ", "weights"}]}], "    ", "*)"}], "\n", 
    RowBox[{"(*", "    ", 
     RowBox[{"sigma", " ", "-", " ", "variance", "-", 
      RowBox[{"covariance", " ", "matrix", " ", "sigma"}]}], 
     "                ", "*)"}], "\n", 
    RowBox[{"(*", " ", 
     RowBox[{"The", " ", "portfolio", " ", "variance", " ", "is"}], 
     "                                  ", "*)"}], "\n", 
    RowBox[{"(*", "     ", 
     RowBox[{
      RowBox[{"d", "'"}], " ", "*", " ", "sigma", " ", "*", " ", "d"}], 
     "                                         ", "*)"}], "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
     "We", " ", "need", " ", "the", " ", "following", " ", "as", " ", 
      "intermediate"}], "                      ", "*)"}], "\n", 
    RowBox[{"(*", "     ", 
     RowBox[{"part", " ", "=", " ", 
      RowBox[{
       RowBox[{"sigma", " ", "*", " ", "d"}], " ", "-", " ", 
       RowBox[{
       "column", " ", "vector", " ", "of", " ", "partial", " ", 
        "multiplication"}]}]}], "    ", "*)"}], "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"The", " ", "variance", " ", "when", " ", 
       RowBox[{"the", " ", "'"}], "best", " ", 
       RowBox[{"hedges", "'"}], " ", "for", " ", "i"}], ",", "j", ",", 
      RowBox[{"k", " ", "is"}]}], "           ", "*)"}], "\n", 
    RowBox[{"(*", "     ", 
     RowBox[{"portvar", " ", "-", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"part", "[", 
         RowBox[{"i", " ", "j", " ", "k"}], "]"}], "'"}], " ", "*", " ", 
       "inv", 
       RowBox[{"(", 
        RowBox[{"sigma", "[", 
         RowBox[{
          RowBox[{"i", " ", "j", " ", "k"}], ",", " ", 
          RowBox[{"i", " ", "j", " ", "k"}]}], "]"}], ")"}], " ", "*", " ", 
       RowBox[{"part", "[", 
        RowBox[{"i", " ", "j", " ", "k"}], "]"}]}]}], "  ", "*)"}], "\n", 
    RowBox[{"(*", " ", 
