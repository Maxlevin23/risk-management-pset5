Cell[CellGroupData[{

Cell["Static Display (sliders do not function)", "Subsubsection",
 CellChangeTimes->{{3.53930311223868*^9, 3.539303115646269*^9}, {
  3.539392708341586*^9, 3.539392710822727*^9}, {3.998510420108827*^9, 
