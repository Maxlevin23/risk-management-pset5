Cell["Tables_Ch10 \[LongDash] scenario2", "Title",ExpressionUUID->"11e82583-b392-4f8b-aea2-009ed2e5139e"],

Cell["\<\
Rerun of the Tables_Ch10.nb reports with SamplePort2.m, DistFn1.m and the \
notebook's table functions. Market data file: SamplePort2_scenario2.m. \
Kernel: 15.0.1 for Linux x86 (64-bit) (July 2, 2026).\
\>", "Text",ExpressionUUID->"89a10952-97c6-4cd7-beb4-aec04e511075"],

Cell["Changed inputs (inputs.m)", "Subsection",ExpressionUUID->"6f710106-e489-4a91-81e4-868c8c05f259"],

Cell["\<\
(* Scenario 2 - market-data change on the Scenario 1 portfolio.
   Load SamplePort2_scenario2.m (in this folder) instead of SamplePort2.m.
   Changed in marketDataValues: USDYld10yr .0253 -> .0353, GBPFX 1/1.4 -> \
1/1.6 *)
seclist = {\"10yr UST\",\"5yr Bond Opt\",\"10yr UST\",\"10yr Swap\",\"10yr \
UKG\",\"FTE CDS\",\"CAC Index Futures\",\"FTE \
Equity\",\"GBPCash\",\"EURCash\",\"5yr UST\"};
holdings = {20,-20,30,-20,-25,55,7,5,-10,15,40};
subportfolio = \
{\"Government\",\"Government\",\"Swaps\",\"Swaps\",\"Government\",\"Credit\",\
\"Equity\",\"Equity\",\"Credit\",\"Equity\",\"Government\"};
settledate = {2009,1,27,0,0,0};\
\>", "Program",ExpressionUUID->"d3d26c8e-f8a8-4d40-b512-cad019bf0e7a"],

