Notebook[{
Cell["Tables_Ch10 \[LongDash] scenario1", "Title",ExpressionUUID->"0bfc7144-4636-494a-b921-ae5c38080807"],

Cell["\<\
Rerun of the Tables_Ch10.nb reports with SamplePort2.m, DistFn1.m and the \
notebook's table functions. Market data file: SamplePort2.m. Kernel: 15.0.1 \
for Linux x86 (64-bit) (July 2, 2026).\
\>", "Text",ExpressionUUID->"285d9d11-ac7a-4dff-9763-36537d184082"],

Cell["Changed inputs (inputs.m)", "Subsection",ExpressionUUID->"8f5e8585-eb89-41c5-b14e-97e6730722af"],

Cell["\<\
(* Scenario 1 - portfolio changes. Replace these lines in a copy of \
Tables_Ch10.nb
   saved as Tables_Ch10_scenario1.nb; SamplePort2.m unchanged.
   Changed: holdings 5 (25 -> -25), 10 (0 -> 15), 11 (0 -> 40); subportfolio \
9 (Government -> Credit) *)
seclist = {\"10yr UST\",\"5yr Bond Opt\",\"10yr UST\",\"10yr Swap\",\"10yr \
UKG\",\"FTE CDS\",\"CAC Index Futures\",\"FTE \
Equity\",\"GBPCash\",\"EURCash\",\"5yr UST\"};
holdings = {20,-20,30,-20,-25,55,7,5,-10,15,40};
subportfolio = \
{\"Government\",\"Government\",\"Swaps\",\"Swaps\",\"Government\",\"Credit\",\
\"Equity\",\"Equity\",\"Credit\",\"Equity\",\"Government\"};
settledate = {2009,1,27,0,0,0};\
\>", "Program",ExpressionUUID->"88d48b93-b586-4e4d-a657-936df1a139e2"],

