Notebook[{
Cell["Tables_Ch10 \[LongDash] scenario3", "Title",ExpressionUUID->"c3cafa5a-bfab-4c37-bde8-99420cbb491f"],

Cell["\<\
Rerun of the Tables_Ch10.nb reports with SamplePort2.m, DistFn1.m and the \
notebook's table functions. Market data file: SamplePort2.m. Kernel: 15.0.1 \
for Linux x86 (64-bit) (July 2, 2026).\
\>", "Text",ExpressionUUID->"b7ee6f95-46c0-45ad-be4f-9d5abd84935b"],

Cell["Changed inputs (inputs.m)", "Subsection",ExpressionUUID->"bafbff1e-34a4-412c-bfc0-d13e450f8bf2"],

Cell["\<\
(* Scenario 3 - new securities, new settlement date, fractional and \
offsetting holdings.
   SamplePort2.m unchanged except that settledate is set here AFTER loading \
it. *)
seclist = {\"5yr UST\",\"10yr UST\",\"10yr UST\",\"Swap201901\",\"5yr \
UKG\",\"10yr Bund\",\"5yr Bund\",\"SPX Index Futures\",\"FTE Equity\",\"FTE \
CDS\",\"EURCash\",\"GBPCash\",\"5yr Bond Opt\"};
holdings = {35,-12.5,12.5,-40,18,-22,30,-9,6,25,-8,0,10};
subportfolio = \
{\"Rates\",\"Rates\",\"Macro\",\"Macro\",\"Rates\",\"Macro\",\"Rates\",\"\
Equity\",\"Equity\",\"Credit\",\"Macro\",\"Credit\",\"Rates\"};
settledate = {2009,6,30,0,0,0};\
\>", "Program",ExpressionUUID->"5ae96fa5-86f2-48c9-ade5-9c3aa7ffa26c"],

Cell["1. Holdings (all positions)", "Subsection",ExpressionUUID->"461b79f3-22d0-4163-9a52-2c423a0a62bb"],

